# ==============================================================================
# Configuration de l'application - Prédiction des Prix Agricoles au Bénin
# Copiez ce fichier vers `.env` en local.
# Sur Render et Streamlit Cloud, configurez ces variables dans l'interface web.
# ==============================================================================

# --- Configuration Backend (Render / FastAPI) ---
PORT=8000
LOG_LEVEL=INFO
API_KEY=changez-moi-par-une-cle-secrete-robuste

# --- Configuration Frontend (Streamlit Community Cloud) ---
# En local : http://127.0.0.1:8000
# Sur Streamlit Cloud : https://votre-service-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT=45

# --- Authentification Utilisateur (Streamlit Community Cloud) ---
ADMIN_USER=admin
# Hash SHA-256 du mot de passe administrateur.
# Pour générer un hash : python -c "import hashlib; print(hashlib.sha256('VotreMotDePasse'.encode('utf-8')).hexdigest())"
ADMIN_PASSWORD_HASH=remplacez-par-votre-hash-sha256
